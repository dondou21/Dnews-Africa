# Server
PORT=4000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5000,http://localhost:5001

# Database
# DATABASE_URL: pooled connection for runtime queries (Neon with ?pgbouncer=true or ?pooled)
# Use the postgresql:// scheme; postgres:// is normalized by the container startup script.
# DIRECT_URL: unpooled connection for migrations and DDL
# Neon example:
#   DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
#   DIRECT_URL="postgresql://user:pass@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dnews_africa?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dnews_africa?schema=public"

# JWT (REQUIRED in production - must be a long random string)
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Cloudinary (required for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Media / Uploads
API_URL=http://localhost:4000
MEDIA_BASE_URL=http://localhost:4000/uploads
UPLOAD_DIR=./uploads

# Email (Resend)
# Without RESEND_API_KEY, emails are rendered and captured to .email-captures/ instead of being sent.
# Set a real key to enable delivery. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_PROVIDER=resend
EMAIL_ENABLED=true
EMAIL_FROM=noreply@dnewsafrica.com
EMAIL_CAPTURE_DIR=./.email-captures

# Frontend URLs
CLIENT_URL=http://localhost:5000
SITE_URL=http://localhost:5000
