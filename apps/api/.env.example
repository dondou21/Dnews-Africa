# Server
PORT=4000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5000,http://localhost:5001

# Database
# DATABASE_URL: pooled connection for runtime queries (Neon with ?pgbouncer=true or ?pooled)
# DIRECT_URL: unpooled connection for migrations and DDL
# Neon example:
#   DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
#   DIRECT_URL="postgresql://user:pass@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dnews_africa?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dnews_africa?schema=public"

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# API Docs
ENABLE_API_DOCS=true

# Cloudinary (required for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Media / Uploads
API_URL=http://localhost:4000
MEDIA_BASE_URL=http://localhost:4000/uploads
UPLOAD_DIR=./uploads
