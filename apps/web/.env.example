# Public API base URL (points to the deployed API, e.g. https://api.dnewsafrica.com/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Base URL for media files (e.g. https://api.dnewsafrica.com/uploads)
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:4000/uploads
# Canonical site URL for SEO
NEXT_PUBLIC_SITE_URL=http://localhost:5000

# Contact + social links (public site). Omit to hide the corresponding link.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
